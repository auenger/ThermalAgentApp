{
  "name": "thermal-agent-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "apps/desktop/dist/main.js",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm build:ts && pnpm --filter @thermal-agent/web build",
    "build:ts": "tsc -b",
    "typecheck": "tsc -b --pretty false && pnpm --filter @thermal-agent/web typecheck",
    "test": "pnpm build && node --test tests/*.test.mjs && node scripts/smoke-dsh-agent-tools.mjs && python3 -m unittest discover -s plugins/icepak-pyaedt/tests -v && pnpm test:report",
    "test:report": "uv run --project plugins/report-reportlab python -m unittest discover -s plugins/report-reportlab/tests -v",
    "dev:core": "pnpm build && node --enable-source-maps apps/core/dist/cli.js",
    "dev:web": "pnpm --filter @thermal-agent/web dev",
    "dev:desktop": "pnpm build && electron apps/desktop",
    "smoke:gui": "electron scripts/smoke-electron-gui.mjs",
    "package:win": "pnpm build && node scripts/verify-windows-runtime.mjs && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "@thermal-agent/core": "workspace:*",
    "@thermal-agent/dsh-thermal": "workspace:*",
    "@thermal-agent/process-control": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-app-boot": "0.1.5-rc.2",
    "@deepseek-ai/dsh-cmdline": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@thermal-agent/artifact-store": "workspace:*",
    "@thermal-agent/domain": "workspace:*",
    "@thermal-agent/sqlite-store": "workspace:*",
    "@types/node": "^22.13.0",
    "electron": "^38.0.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.7.3"
  }
}
