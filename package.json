{
  "name": "thermal-agent-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "apps/desktop/dist/main.js",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm build:ts && pnpm --filter @thermal-agent/web build",
    "build:ts": "tsc -b",
    "typecheck": "tsc -b --pretty false && pnpm --filter @thermal-agent/web typecheck",
    "test": "pnpm build && node scripts/run-node-tests.mjs && node scripts/smoke-dsh-agent-tools.mjs && node scripts/run-icepak-tests.mjs && pnpm test:report",
    "test:report": "uv run --project plugins/report-reportlab python -m unittest discover -s plugins/report-reportlab/tests -v",
    "dev:core": "pnpm build && node --enable-source-maps apps/core/dist/cli.js",
    "dev:web": "pnpm --filter @thermal-agent/web dev",
    "dev:desktop": "pnpm build && electron apps/desktop",
    "smoke:gui": "electron scripts/smoke-electron-gui.mjs",
    "package:win": "pnpm build && node scripts/verify-windows-runtime.mjs && electron-builder --win nsis --x64",
    "package:win:cross": "pnpm build && electron-builder --win nsis --x64 -c.npmRebuild=false -c.directories.output=release-cross"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.2",
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.5-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-authorization": "0.1.5-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.5-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.5-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-hook-protocol": "0.1.5-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-query": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.5-rc.2",
    "@deepseek-ai/dsh-spill": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-time": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.5-rc.2",
    "@deepseek-ai/dsh-workflow": "0.1.5-rc.2",
    "@thermal-agent/core": "workspace:*",
    "@thermal-agent/dsh-thermal": "workspace:*",
    "@thermal-agent/process-control": "workspace:*"
  },
  "optionalDependencies": {
    "@img/sharp-win32-x64": "0.35.4",
    "@koromix/koffi-win32-x64": "3.3.1",
    "@vscode/ripgrep-win32-x64": "1.18.0",
    "node-addon-require-builtin-win32-x64-msvc": "0.1.6"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-app-boot": "0.1.5-rc.2",
    "@deepseek-ai/dsh-cmdline": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@thermal-agent/artifact-store": "workspace:*",
    "@thermal-agent/domain": "workspace:*",
    "@thermal-agent/sqlite-store": "workspace:*",
    "@types/node": "^22.13.0",
    "electron": "^38.0.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.7.3"
  }
}
